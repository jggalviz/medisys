# ============================================================================
# MEDISYS · Environment variables
# ----------------------------------------------------------------------------
# 1. Copy this file to `.env.local` (Next.js loads it automatically).
#      cp .env.example .env.local      # macOS / Linux
#      Copy-Item .env.example .env.local   # Windows PowerShell
# 2. Fill in the Supabase values (Project Settings → API).
# 3. Never commit `.env.local`: only this template is versioned.
# ============================================================================

# ─── Supabase (required) ────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key. Safe to expose: every query is still constrained by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER-ONLY. Grants full database access (bypasses RLS): cron rate upserts,
# portal authentication, storage bucket bootstrap and public help-centre reads.
# Never expose it to the browser or to client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Vercel Cron (required for /api/cron/bcv-rate) ──────────────────────────
# Validated as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-secret

# ─── Portal sessions (required in production) ───────────────────────────────
# HMAC-SHA256 key that signs the httpOnly `portal_session` cookie used by the
# specialist and patient portals. In development it falls back to
# `medisys-portal-dev-secret`, which must never be used in production.
PORTAL_SESSION_SECRET=replace-with-a-long-random-secret

# ─── SaaS subscription payment details (optional) ───────────────────────────
# Shown to clinics on the "renovar membresía" screen when they pay Medisys.
SAAS_PAGO_MOVIL_BANCO="Banesco (0134)"
SAAS_PAGO_MOVIL_CEDULA="J-40555123-7"
SAAS_PAGO_MOVIL_TELEFONO="0414-1234567"
SAAS_PAGO_MOVIL_TITULAR="Medisys C.A."

# ─── Troubleshooting / developer tooling (optional) ─────────────────────────
# Set to 1 to keep strict TLS verification when scraping bcv.org.ve. When
# unset, a single retry with relaxed TLS is allowed because the official portal
# publishes an incomplete certificate chain.
# BCV_TLS_ESTRICTO=1

# Supabase Management API token (sbp_...) used by scripts/aplicar-migracion-*.mjs
# to execute DDL statements against the project.
# SUPABASE_ACCESS_TOKEN=

# Direct Postgres connection used by the same scripts as a second strategy
# (requires the optional `pg` driver: node scripts/... --instalar-driver).
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
